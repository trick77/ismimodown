# Copy to .env and fill in. .env (and every .env.* variant) is gitignored —
# BACKEND_MIMO_API_KEY is a live billable credential and this repo is public.
#
# Exactly one setting below is uncommented, because exactly one has to be
# supplied. Everything else is commented out and shows the value the binary
# already uses: the file documents the knobs without turning each of them into
# a value someone has to keep in sync.

# --- The only required setting ---
# The tp- token-plan key. The container refuses to start without it, by design:
# a keyless deployment would record an unbroken wall of auth failures, and the
# dashboard would render that as a MiMo outage.
BACKEND_MIMO_API_KEY=tp-replace-me

# --- Server ---
# BACKEND_ADDR=:8080
# BACKEND_LOG_LEVEL=info
# The container mounts ./data at /data. Overridable because hack/dev.sh runs the
# daemon straight on the host, where /data does not exist and cannot be created.
# BACKEND_DB_PATH=/data/mimostats.db

# --- MiMo endpoint ---
# The token-plan host the tp- key is issued against. Both mimo-v2.5 and
# mimo-v2.5-pro are served here.
#
# This value must never carry a credential: no user:pass@ and no ?api_key=.
# The daemon refuses to start on either. The key goes in BACKEND_MIMO_API_KEY and nowhere else.
# BACKEND_MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# Comma-separated. Both are confirmed served on the tp- key. The registry takes
# a second vendor as configuration, which is what makes the single-vendor scope
# a decision rather than an architectural limit.
# BACKEND_MODELS=mimo-v2.5,mimo-v2.5-pro

# --- Probe shaping ---
# Impersonates opencode, because that is what MiMo's token-plan endpoint sees in
# production.
# BACKEND_PROBE_USER_AGENT=opencode/1.18.11 ai-sdk/openai-compatible/3.0.20 ai-sdk/provider-utils/5.0.18 runtime/bun/1.3.14

# NOT cosmetic, and do not remove. With no system message MiMo injects its own —
# measured at 250 prompt tokens, 192 of them served from cache. That inflates the
# token budget ~6.5x AND turns the prefill the probe is meant to time into a cache
# lookup. Any non-empty system message suppresses it (prompt_tokens drops to 20).
# BACKEND_PROBE_SYSTEM_PROMPT=You are a helpful assistant.

# --- TCP ping targets (bare hostname or IP; no scheme, no port) ---
# MiMo's own edge.
# BACKEND_PING_MIMO_HOST=token-plan-sgp.xiaomimimo.com
# "Is *any* Europe->Singapore path healthy". The plan originally named an OVH
# SGP endpoint for a same-carrier path, but no such public hostname exists
# (ap-southeast-sgp does not resolve; sgp.ovh answers from Cloudflare anycast in
# Europe). DigitalOcean's SGP endpoint is a genuine Singapore target; the
# same-carrier caveat is disclosed on the site.
# BACKEND_PING_REF_SGP_HOST=sgp1.digitaloceanspaces.com

# --- Retention ---
# 3 months of raw samples, swept nightly. No rollups.
# BACKEND_RETENTION=2160h

# --- Timeout ladder ---
# A single outer deadline records "slow" and "dead" identically, so each layer
# has its own bound and its own error class. TTFT and idle must both stay below
# the overall deadline or they can never fire (enforced at boot).
# BACKEND_PING_TIMEOUT=5s            -> connect_timeout
# BACKEND_PROBE_DIAL_TIMEOUT=10s     -> connect_timeout
# BACKEND_PROBE_HEADER_TIMEOUT=60s   -> header_timeout
# BACKEND_PROBE_TTFT_TIMEOUT=150s    -> ttft_timeout
# BACKEND_PROBE_IDLE_TIMEOUT=45s     -> stalled
# BACKEND_PROBE_TIMEOUT=240s         -> timeout
