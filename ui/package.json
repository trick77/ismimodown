{
  "name": "ismimodown-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "TZ=Europe/Zurich vitest",
    "test:coverage": "TZ=Europe/Zurich vitest run --coverage",
